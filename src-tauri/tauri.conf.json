{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KovOBS",
  "identifier": "KovOBS",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/kovobs/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KovOBS",
        "width": 900,
        "height": 760,
        "minWidth": 900,
        "titleBarStyle": "Overlay",
        "decorations": false,
        "visible": false,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "./resources/default-config.json": "default-config.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
